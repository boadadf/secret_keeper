{
  "schema_version": 2,
  "inspection": {
    "max_input_bytes": 2097152,
    "max_views": 4096,
    "max_json_depth": 64,
    "decode_depth": 2,
    "max_decoded_bytes": 524288,
    "decoders": [
      "percent",
      "hex",
      "base64"
    ]
  },
  "rules": [
    {
      "id": "customer-names",
      "type": "dictionary",
      "enabled": true,
      "action": "block",
      "matching": {
        "case_sensitive": false,
        "unicode_normalization": "NFKC",
        "whitespace": "collapse",
        "boundary": "whole_phrase"
      },
      "entries": [
        {
          "id": "customer-001",
          "values": [
            "Northstar Manufacturing"
          ]
        }
      ]
    },
    {
      "id": "internal-urls",
      "type": "url_domain",
      "enabled": true,
      "action": "block",
      "domains": [
        "example.internal"
      ],
      "include_subdomains": true
    },
    {
      "id": "customer-email",
      "type": "email",
      "enabled": true,
      "action": "block",
      "domains": [
        "customer.example"
      ],
      "include_subdomains": true,
      "addresses": [
        "restricted@example.test"
      ]
    },
    {
      "id": "internal-networks",
      "type": "ip_network",
      "enabled": true,
      "action": "block",
      "networks": [
        "10.20.0.0/16",
        "fd12:3456:789a::/48"
      ]
    },
    {
      "id": "registered-usernames",
      "type": "field",
      "enabled": true,
      "action": "block",
      "fields": [
        "username",
        "login",
        "employee_id"
      ],
      "values": [
        "synthetic-user-001"
      ],
      "case_sensitive": false
    },
    {
      "id": "password-hash-fields",
      "type": "field",
      "enabled": true,
      "action": "block",
      "fields": [
        "password_hash"
      ],
      "values": [],
      "case_sensitive": false
    },
    {
      "id": "registered-resources",
      "type": "resource",
      "enabled": true,
      "action": "block",
      "values": [
        "/srv/secretkeeper-test/private/",
        "synthetic-private-bucket-001"
      ],
      "case_sensitive": true
    },
    {
      "id": "credential-assignment",
      "type": "builtin",
      "enabled": true,
      "action": "block",
      "detector": "credential_assignment"
    },
    {
      "id": "credential-field",
      "type": "builtin",
      "enabled": true,
      "action": "block",
      "detector": "credential_field"
    },
    {
      "id": "private-key-block",
      "type": "builtin",
      "enabled": true,
      "action": "block",
      "detector": "private_key_block"
    },
    {
      "id": "supported-token-format",
      "type": "builtin",
      "enabled": true,
      "action": "block",
      "detector": "supported_token_format"
    },
    {
      "id": "connection-string",
      "type": "builtin",
      "enabled": true,
      "action": "block",
      "detector": "connection_string"
    },
    {
      "id": "credit-card",
      "type": "builtin",
      "enabled": true,
      "action": "audit",
      "detector": "credit_card"
    },
    {
      "id": "iban",
      "type": "builtin",
      "enabled": true,
      "action": "audit",
      "detector": "iban"
    },
    {
      "id": "phone-candidate",
      "type": "builtin",
      "enabled": true,
      "action": "audit",
      "detector": "phone_candidate"
    },
    {
      "id": "hash-candidate",
      "type": "builtin",
      "enabled": true,
      "action": "audit",
      "detector": "hash_candidate"
    },
    {
      "id": "entropy-candidate",
      "type": "builtin",
      "enabled": true,
      "action": "audit",
      "detector": "entropy_candidate"
    },
    {
      "id": "synthetic-canary",
      "type": "exact_text",
      "enabled": false,
      "action": "block",
      "value": "SECRET_KEEPER_CONFIDENTIAL_CANARY"
    }
  ]
}
